# Jamais de secrets dans le code : copier vers .env (dev) ou injecter via l'hébergeur (staging/production).
SITE_URL=http://localhost:3000
DATABASE_URL=mysql://dd_app:change-me@127.0.0.1:3306/dd_consulting
# Adresse qui reçoit les notifications de nouvelle réservation
ADMIN_NOTIFY_EMAIL=contact@example.com
# Clé HMAC pour les liens d'annulation / reprogrammation
BOOKING_TOKEN_SECRET=change-me-with-32-random-bytes
NEXT_PUBLIC_CONTACT_EMAIL=contact@dd-consulting.fr
